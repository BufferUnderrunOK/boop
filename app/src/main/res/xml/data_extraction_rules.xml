<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone: the imported Tile keys are encrypted with a Keystore key that can't
     be backed up or transferred anyway, and the rest is a single on/off setting. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
